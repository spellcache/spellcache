# spellcache configuration.
#
#   cp .env.example .env
#
# One `.env` at the repository root, read by every tool: the Next.js app, the
# worker, drizzle-kit, Playwright, and `docker compose` (for `${...}`
# interpolation in docker-compose.example.yml). Never commit it.
#
# Sections:
#   1. Development   — running the app on your machine (`pnpm dev`)
#   2. Production    — self-hosting with docker-compose.example.yml
#   3. Worker        — nightly import schedule (both)
#   4. Backup        — deploy/backup.sh and deploy/restore.sh, on the host
#
# Legend: [required] must be set · [optional] has a default; optional lines are
# commented out — uncomment them only to change the default (an empty value
# is not the same as an unset one).

# =============================================================================
# 1. Development
# =============================================================================

# [required] PostgreSQL connection string, as seen from where the code runs.
# Matches the `postgres` service of docker-compose.yml.
# In production (section 4), this is the host's view, used by the backup
# scripts only — containers get their own URL from the Compose file.
DATABASE_URL=postgres://spellcache:spellcache@localhost:5432/spellcache

# [optional] Redis/Valkey connection string. Search cache, worker job queue and
# rate limits. Without it, search is uncached and rate limits fall back to an
# in-memory counter. Default: unset.
REDIS_URL=redis://localhost:6379

# [optional] Disk cache of card thumbnails served by the image proxy.
# Default: `thumbs/` in the web app's working directory. Containers use
# /app/thumbs (a volume).
# THUMBNAILS_DIR=./thumbs

# [required] Secret that signs session cookies (Auth.js). Generate it once and
# keep it: changing it signs everyone out.
#   openssl rand -base64 32
AUTH_SECRET=

# [optional in development, required in production] Resend API key, used to
# send sign-in emails. Without it, in development only, sign-in links are
# printed in the `pnpm dev` console.
RESEND_API_KEY=

# [optional in development, required in production] Sender of sign-in emails,
# "Name <address>". Its domain must be verified in Resend. Default:
# spellcache <onboarding@resend.dev>, Resend's test sender, which only delivers
# to your own Resend account address.
# RESEND_FROM_EMAIL="spellcache <signin@your-domain.example>"

# [optional in development, required in production] Email of the first
# administrator: only this address may create the first account of an empty
# database, and it becomes admin. Unset: the first account created becomes
# admin, whoever it is.
ADMIN_EMAIL=

# =============================================================================
# 2. Production (docker-compose.example.yml)
# =============================================================================

# [optional] Image version to run: `1.2.3`, `1.2`, or `latest`. Default: latest.
# SPELLCACHE_VERSION=latest

# [required] PostgreSQL credentials and database name for the `postgres`
# service. The password ends up in a URL: keep it alphanumeric to avoid
# encoding it.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# [required] Full public URL of the app, scheme included
# (e.g. https://spellcache.example). Used to build sign-in links.
AUTH_URL=

# [optional] Interface and port on which the `web` container is published on
# the host, for your own reverse proxy. Defaults: 127.0.0.1 and 3000.
# WEB_BIND=127.0.0.1
# WEB_PORT=3000

# =============================================================================
# 3. Worker
# =============================================================================

# [optional] Local time ("HH:MM") of the nightly import and revaluation, and the
# IANA time zone it is read in. Defaults: 03:15 and UTC. A worker restarted
# within the hour after that time still runs the night; later, it waits for the
# next one.
WORKER_NIGHTLY_AT=03:15
WORKER_TIMEZONE=UTC

# [optional, legacy] UTC hour (0-23) of the nightly run. Ignored when
# WORKER_NIGHTLY_AT is set.
# WORKER_NIGHTLY_HOUR_UTC=3

# [optional] Port of the worker's internal health check (GET /health), never
# published outside the Docker network. Default: 8081.
# WORKER_HEALTH_PORT=8081

# =============================================================================
# 4. Backup (deploy/backup.sh, deploy/restore.sh — run on the host)
# =============================================================================
#
# Not read by docker compose: the scripts read them from the cron job's or the
# shell's environment (see deploy/cron.md). DATABASE_URL (section 1) must then
# point to 127.0.0.1:5432, where docker-compose.example.yml publishes Postgres:
#   postgres://<POSTGRES_USER>:<POSTGRES_PASSWORD>@127.0.0.1:5432/<POSTGRES_DB>

# [required for backups] Off-server destination of the encrypted archive:
#   file:///absolute/path       — local or mounted remote disk
#   ssh://user@host:/path       — copy with scp, rotation over ssh
BACKUP_DEST=

# [required for backups] Passphrase of the archive's AES-256 encryption. Keep a
# copy somewhere else than the server: no archive can be restored without it.
#   openssl rand -base64 32
BACKUP_PASSPHRASE=

# [optional] Days of archives kept at the destination. Default: 30.
# BACKUP_RETENTION_DAYS=30
