<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background">

    <!-- Zone de la caméra, jusqu'au panneau du bas ; sous la barre du haut
         ou derrière elle selon l'affichage choisi (marges posées par
         `ScannerActivity`). -->
    <FrameLayout
        android:id="@+id/scanner_camera_area"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.camera.view.PreviewView
            android:id="@+id/scanner_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <io.github.spellcache.scanner.ScanFrameView
            android:id="@+id/scanner_frame"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!-- Barre du haut et réglages en surcouche : le cadre ne change jamais
         de taille ni de place, on voit l'effet d'un réglage sur la carte. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/scanner_top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp">

            <ImageButton
                android:id="@+id/scanner_back"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/scanner_round_button"
                android:contentDescription="@string/scanner_back"
                android:src="@drawable/ic_scanner_back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/scanner_title"
                android:textColor="@android:color/white"
                android:textSize="17sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/scanner_settings_button"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/scanner_round_button"
                android:contentDescription="@string/scanner_settings"
                android:src="@drawable/ic_scanner_settings" />

            <ImageButton
                android:id="@+id/scanner_torch"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/scanner_round_button"
                android:contentDescription="@string/scanner_torch"
                android:src="@drawable/ic_scanner_torch"
                android:visibility="invisible" />
        </LinearLayout>

        <!-- Défilant : sa hauteur est bornée à l'espace entre les deux barres
             (`ScannerActivity.layoutCameraArea`) ; barre de défilement fine,
             dans les coins arrondis du panneau. -->
        <ScrollView
            android:id="@+id/scanner_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/scanner_overlay"
            android:clickable="true"
            android:fadeScrollbars="false"
            android:focusable="false"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:paddingBottom="14dp"
            android:scrollbarSize="10dp"
            android:scrollbarStyle="outsideOverlay"
            android:scrollbarThumbVertical="@drawable/scanner_scrollbar_thumb"
            android:scrollbarTrackVertical="@android:color/transparent"
            android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Lecture : ce qui est lu, puis comment c'est affiché. -->
            <TextView
                style="@style/ScannerGroupLabel"
                android:text="@string/scanner_group_scan" />

            <TextView
                style="@style/ScannerSectionLabel"
                android:text="@string/scanner_mode" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/scanner_mode_frame"
                    style="@style/ScannerChip"
                    android:text="@string/scanner_mode_frame" />

                <Button
                    android:id="@+id/scanner_mode_auto"
                    style="@style/ScannerChip"
                    android:text="@string/scanner_mode_auto" />
            </LinearLayout>

            <TextView
                android:id="@+id/scanner_mode_hint"
                style="@style/ScannerHint" />

            <LinearLayout
                android:id="@+id/scanner_frame_size_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/ScannerSectionLabel"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/scanner_frame_size" />

                    <TextView
                        android:id="@+id/scanner_frame_size_value"
                        style="@style/ScannerSectionLabel"
                        android:textColor="@android:color/white" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/scanner_frame_size"
                    style="@style/ScannerSlider" />
            </LinearLayout>

            <TextView
                style="@style/ScannerSectionLabel"
                android:text="@string/scanner_view" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/scanner_view_fill"
                    style="@style/ScannerChip"
                    android:text="@string/scanner_view_fill" />

                <Button
                    android:id="@+id/scanner_view_whole"
                    style="@style/ScannerChip"
                    android:text="@string/scanner_view_whole" />
            </LinearLayout>

            <TextView
                android:id="@+id/scanner_view_hint"
                style="@style/ScannerHint" />

            <!-- Caméra : dans l'ordre des applis photo. -->
            <View style="@style/ScannerGroupDivider" />

            <TextView
                style="@style/ScannerGroupLabel"
                android:text="@string/scanner_group_camera" />

            <LinearLayout
                android:id="@+id/scanner_camera_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/ScannerSectionLabel"
                    android:text="@string/scanner_lens" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/scanner_cameras"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/scanner_zoom_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/ScannerSectionLabel"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/scanner_zoom" />

                    <TextView
                        android:id="@+id/scanner_zoom_value"
                        style="@style/ScannerSectionLabel"
                        android:textColor="@android:color/white" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/scanner_zoom_presets"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />

                <SeekBar
                    android:id="@+id/scanner_zoom"
                    style="@style/ScannerSlider"
                    android:layout_marginTop="6dp"
                    android:max="100" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/scanner_focus_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/ScannerSectionLabel"
                    android:text="@string/scanner_focus" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/scanner_focus_continuous"
                            style="@style/ScannerChip"
                            android:text="@string/scanner_focus_continuous" />

                        <Button
                            android:id="@+id/scanner_focus_tap"
                            style="@style/ScannerChip"
                            android:text="@string/scanner_focus_tap" />

                        <Button
                            android:id="@+id/scanner_focus_manual"
                            style="@style/ScannerChip"
                            android:text="@string/scanner_focus_manual" />
                    </LinearLayout>
                </HorizontalScrollView>

                <TextView
                    android:id="@+id/scanner_focus_hint"
                    style="@style/ScannerHint" />

                <LinearLayout
                    android:id="@+id/scanner_focus_manual_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/ScannerSliderEnd"
                        android:text="@string/scanner_focus_near" />

                    <SeekBar
                        android:id="@+id/scanner_focus_distance"
                        style="@style/ScannerSlider"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:max="100" />

                    <TextView
                        style="@style/ScannerSliderEnd"
                        android:text="@string/scanner_focus_far" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/scanner_exposure_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/ScannerSectionLabel"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/scanner_exposure" />

                    <TextView
                        android:id="@+id/scanner_exposure_value"
                        style="@style/ScannerSectionLabel"
                        android:textColor="@android:color/white" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/scanner_exposure_auto"
                        style="@style/ScannerChip"
                        android:text="@string/scanner_exposure_auto" />

                    <Button
                        android:id="@+id/scanner_exposure_manual"
                        style="@style/ScannerChip"
                        android:text="@string/scanner_exposure_manual" />
                </LinearLayout>

                <TextView
                    android:id="@+id/scanner_exposure_hint"
                    style="@style/ScannerHint" />

                <SeekBar
                    android:id="@+id/scanner_exposure"
                    style="@style/ScannerSlider"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/scanner_flash_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/ScannerSectionLabel"
                    android:text="@string/scanner_flash" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/scanner_flash_off"
                        style="@style/ScannerChip"
                        android:text="@string/scanner_flash_off" />

                    <Button
                        android:id="@+id/scanner_flash_on"
                        style="@style/ScannerChip"
                        android:text="@string/scanner_flash_on" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/scanner_flash_level_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/ScannerSectionLabel"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/scanner_flash_level" />

                        <TextView
                            android:id="@+id/scanner_flash_level_value"
                            style="@style/ScannerSectionLabel"
                            android:textColor="@android:color/white" />
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/scanner_flash_level"
                        style="@style/ScannerSlider" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- Actions rapides sur la dernière carte comptée : édition, langue,
         foil. Au-dessus du panneau du bas (`layoutCameraArea`). -->
    <LinearLayout
        android:id="@+id/scanner_quick_actions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/scanner_quick_set"
            style="@style/ScannerQuickAction"
            android:contentDescription="@string/scanner_quick_set" />

        <TextView
            android:id="@+id/scanner_quick_language"
            style="@style/ScannerQuickAction"
            android:layout_marginTop="10dp"
            android:clickable="true"
            android:contentDescription="@string/scanner_quick_language"
            android:focusable="true"
            android:gravity="center"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/scanner_quick_foil"
            style="@style/ScannerQuickAction"
            android:layout_marginTop="10dp"
            android:contentDescription="@string/scanner_quick_foil"
            android:src="@drawable/ic_scanner_foil" />
    </LinearLayout>

    <!-- Hauteur fixe (lignes de texte fixes) : le cadre reste en place quel
         que soit le message affiché. -->
    <LinearLayout
        android:id="@+id/scanner_bottom_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/scanner_panel"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="18dp">

        <!-- Dernière carte comptée et ses exemplaires (− / +). -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/scanner_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:lines="1"
                    android:text="@string/scanner_hint"
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/scanner_detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:lines="2"
                    android:text="@string/scanner_hint_detail"
                    android:textColor="@color/scanner_text_2"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/scanner_qty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="invisible">

                <Button
                    android:id="@+id/scanner_qty_minus"
                    style="@style/ScannerQtyButton"
                    android:contentDescription="@string/scanner_qty_decrease"
                    android:text="−" />

                <TextView
                    android:id="@+id/scanner_qty_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="32dp"
                    android:gravity="center"
                    android:fontFamily="monospace"
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/scanner_qty_plus"
                    style="@style/ScannerQtyButton"
                    android:contentDescription="@string/scanner_qty_increase"
                    android:text="+" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/scanner_undo"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/scanner_button_secondary"
                android:enabled="false"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:stateListAnimator="@null"
                android:text="@string/scanner_undo"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/scanner_done"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/scanner_button_primary"
                android:stateListAnimator="@null"
                android:text="@string/scanner_done"
                android:textAllCaps="false"
                android:textColor="@color/scanner_on_accent"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
