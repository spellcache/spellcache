---
// Titre de page précédé de son groupe de la barre latérale (« Self-hosting ›
// Installation »), pour situer la page sans remonter la navigation.
import type { StarlightRouteData } from '@astrojs/starlight/route-data'

type SidebarEntry = StarlightRouteData['sidebar'][number]

// Identifiant attendu par le lien « Overview » du sommaire de Starlight
// (PAGE_TITLE_ID, non exporté par le paquet).
const PAGE_TITLE_ID = '_top'

const { entry, sidebar } = Astro.locals.starlightRoute

const findGroup = (entries: SidebarEntry[], parent?: string): string | undefined => {
  for (const item of entries) {
    if (item.type === 'link' && item.isCurrent) return parent
    if (item.type === 'group') {
      const found = findGroup(item.entries, item.label)
      if (found) return found
    }
  }
  return undefined
}

const group = findGroup(sidebar)
---

{group && <p class="sc-crumbs">{group} › {entry.data.title}</p>}
<h1 id={PAGE_TITLE_ID}>{entry.data.title}</h1>

<style>
  .sc-crumbs {
    margin: 1rem 0 0;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
  h1 {
    margin-top: 0.25rem;
    font-size: var(--sl-text-h1);
    line-height: 1.15;
    font-weight: 700;
    letter-spacing: -0.025em;
    text-wrap: balance;
    color: var(--sl-color-white);
  }
  .sc-crumbs + h1 {
    margin-top: 0.25rem;
  }
  h1:first-child {
    margin-top: 1rem;
  }
</style>
