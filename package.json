{
  "name": "spellcache",
  "version": "0.5.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @spellcache/web dev",
    "android:dev": "pnpm --filter @spellcache/android dev",
    "docs:dev": "pnpm --filter @spellcache/docs dev",
    "docs:build": "pnpm --filter @spellcache/docs build",
    "build": "pnpm --filter @spellcache/web build",
    "start": "pnpm --filter @spellcache/web start",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm -r --workspace-concurrency=1 --no-bail test",
    "test:e2e": "pnpm --filter @spellcache/web test:e2e",
    "db:generate": "pnpm --filter @spellcache/db generate",
    "db:migrate": "pnpm --filter @spellcache/db migrate",
    "import:bulk": "pnpm --filter @spellcache/worker import:bulk",
    "worker": "pnpm --filter @spellcache/worker start"
  },
  "devDependencies": {
    "eslint": "^9.17.0",
    "eslint-config-next": "16.4.2",
    "prettier": "^3.4.2",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@10.27.0",
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.23",
      "source-map-js": "^1.2.2",
      "shell-quote": "^1.11.0",
      "sharp": "^0.35.5",
      "vite@<7.3.5": "^7.3.5",
      "esbuild@<0.25.0": "^0.25.12",
      "postcss-selector-parser@<7.1.6": "^7.1.6",
      "uuid@<11.1.1": "^11.1.1"
    }
  }
}
